# Runtime
APP_ENV=development
BACKEND_PORT=8000
FRONTEND_PORT=18080
API_BASE_URL=http://localhost:8000
PUBLIC_WEB_URL=http://localhost:18080
ALLOWED_ORIGINS=http://localhost:18080,http://127.0.0.1:18080

# Frontend-safe Supabase configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Backend-only secrets (never expose through dart-define)
SUPABASE_SERVICE_KEY=your-service-role-key
# Optional: point the backend and video worker to a local Supabase project.
BACKEND_SUPABASE_URL=http://host.docker.internal:54321
BACKEND_SUPABASE_ANON_KEY=your-local-anon-key
BACKEND_SUPABASE_SERVICE_KEY=your-local-service-role-key
# Usually omitted: the worker inherits BACKEND_SUPABASE_* by default.
VIDEO_WORKER_SUPABASE_URL=http://host.docker.internal:54321
VIDEO_WORKER_SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
CERTIFICATE_SECRET_KEY=replace-with-at-least-32-random-characters

# Payments
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

# Reproducible container toolchains
PYTHON_VERSION=3.13.14
FLUTTER_VERSION=3.44.9
FLUTTER_SHA256=a9120fa4a01048bdef438ddc3a2d4b7389662ea98a95db86eeaf10382bc4efcb
