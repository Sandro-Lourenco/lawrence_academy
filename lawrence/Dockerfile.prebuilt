# Runtime-only image for local releases built with the verified host Flutter SDK.
# The canonical production image remains Dockerfile (hermetic multi-stage build).
FROM nginx:1.30.4-alpine3.24

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --chown=nginx:nginx build/web /usr/share/nginx/html

RUN chown -R nginx:nginx /etc/nginx/conf.d /usr/share/nginx/html /var/cache/nginx /var/run

USER nginx
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["wget", "--quiet", "--tries=1", "--spider", "http://127.0.0.1:8080/health"]

ENTRYPOINT ["nginx"]
CMD ["-g", "daemon off;"]
